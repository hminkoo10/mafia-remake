DISCORD_TOKEN=your_bot_token_here

# 레이트리밋 분산용 워커 봇 토큰(선택). 쉼표/공백/줄바꿈으로 여러 개 구분.
# 각 워커 봇은 게임을 진행할 서버에 초대되어 있어야 하고, "채널 관리 / 역할 관리 /
# 웹훅 관리" 권한과 관리 대상보다 높은 역할 위치가 필요하다. 채널 권한·채널 생성/삭제·
# 슬로우모드·역할 부여·웹훅 생성이 (메인+워커) 토큰으로 분산되어 예산이 (N+1)배가 된다.
# 슬래시/버튼 응답과 상태 메시지, 웹훅 실행은 항상 메인 토큰(DISCORD_TOKEN)이 처리한다.
# DISCORD_WORKER_TOKENS=worker_bot_token_1,worker_bot_token_2,worker_bot_token_3

# ── 웹 서버 (권장: Cloudflare 프록시 + Cloudflare Origin 인증서) ─────────────
# 도메인을 Cloudflare 프록시(주황 구름)로 두면 브라우저는 Cloudflare 인증서를 보고,
# 봇은 Cloudflare Origin 인증서(cert.pub/cert.key)로 Cloudflare와 통신한다.
# Cloudflare가 https로 프록시하는 포트: 443, 2053, 2083, 2087, 2096, 8443
# (8880, 8080, 2052 등은 http 전용이라 https로 쓸 수 없다)
#   - Activity + 카지노 웹: 2053
#   - 관리자 설정 웹:       8443
WEB_SETTINGS_HOST=0.0.0.0
WEB_SETTINGS_PORT=8443
WEB_SETTINGS_BASE_URL=https://example.com:8443
# 비우면 ACTIVITY_TLS_CERT/KEY를 같이 쓴다 (같은 도메인이면 그대로 두면 된다)
# WEB_SETTINGS_TLS_CERT=/path/to/cert.pub
# WEB_SETTINGS_TLS_KEY=/path/to/cert.key

ACTIVITY_PORT=2053
ACTIVITY_STATIC_DIR=/path/to/activity/dist
ACTIVITY_TLS_CERT=/path/to/cert.pub
ACTIVITY_TLS_KEY=/path/to/cert.key
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# 카지노 (Activity 서버와 같은 포트에서 /casino/... 로 서비스된다)
# 개인 링크의 공개 주소. 비우면 WEB_SETTINGS_BASE_URL의 호스트 + ACTIVITY_PORT로 만든다
# (예: https://example.com:2053). 다른 도메인을 쓸 때만 지정한다.
# CASINO_BASE_URL=https://example.com:2053
# 빌드에 내장된 카지노 웹 대신 디스크의 dist를 쓰려면 지정 (선택)
# CASINO_STATIC_DIR=/path/to/casino-web/dist
